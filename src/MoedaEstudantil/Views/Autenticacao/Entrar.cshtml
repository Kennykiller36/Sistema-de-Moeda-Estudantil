@model LoginFormulario
@{
    ViewData["Title"] = "Entrar";
}

<section class="cabeca-pagina">
    <div>
        <h1>Entrar</h1>
        <p>Use o e-mail e a senha definidos no cadastro. Professores entram com o e-mail institucional e a senha inicial recebida da instituição.</p>
    </div>
</section>

<form class="formulario formulario-estreito" asp-action="Entrar" method="post">
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
    <div asp-validation-summary="ModelOnly" class="aviso aviso-erro"></div>
    <div class="campo">
        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="username" />
        <span asp-validation-for="Email"></span>
    </div>
    <div class="campo">
        <label asp-for="Senha"></label>
        <input asp-for="Senha" autocomplete="current-password" />
        <span asp-validation-for="Senha"></span>
    </div>
    <div class="acoes">
        <button class="botao" type="submit">Entrar</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
