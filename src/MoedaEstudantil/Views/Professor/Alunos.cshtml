@model IReadOnlyList<Aluno>
@{
    ViewData["Title"] = "Alunos";
}

<section class="cabeca-pagina">
    <div>
        <p class="olho">Professor · @ViewData["Instituicao"]</p>
        <h1>Alunos da instituição</h1>
        <p>Só aparecem alunos da mesma instituição, que são os que podem receber as suas moedas.</p>
    </div>
</section>

@if (Model.Count == 0)
{
    <p class="vazio">Nenhum aluno da sua instituição se cadastrou ainda.</p>
}
else
{
    <div class="tabela-rolagem">
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Curso</th>
                    <th>E-mail</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var aluno in Model)
            {
                <tr>
                    <td>@aluno.Nome</td>
                    <td>@aluno.Curso</td>
                    <td>@aluno.Email</td>
                    <td class="acoes-tabela"><a asp-action="Enviar" asp-route-alunoId="@aluno.Id">Enviar moedas</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
