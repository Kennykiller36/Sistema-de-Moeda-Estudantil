@model EmpresaParceira
@{
    ViewData["Title"] = "Excluir empresa";
}

<section class="cabeca-pagina">
    <div>
        <h1>Excluir empresa</h1>
        <p>@Model.NomeFantasia (@Documento.FormatarCnpj(Model.Cnpj)) será removida do sistema. Esta ação não pode ser desfeita.</p>
    </div>
</section>

<form class="formulario formulario-estreito" method="post" asp-action="ConfirmarExclusao" asp-route-id="@Model.Id">
    <div class="acoes">
        <button class="botao botao-perigo" type="submit">Excluir empresa</button>
        <a class="botao botao-secundario" asp-action="Detalhes" asp-route-id="@Model.Id">Cancelar</a>
    </div>
</form>
