@model EmpresaParceira
@{
    ViewData["Title"] = Model.NomeFantasia;
}

<section class="cabeca-pagina">
    <div>
        <p class="olho">Empresa parceira</p>
        <h1>@Model.NomeFantasia</h1>
        <p>@Model.Email</p>
    </div>
    @if (SessaoCookie.EhDono(User, Model.Id))
    {
        <div class="acoes">
            <a class="botao" asp-action="Editar" asp-route-id="@Model.Id">Editar</a>
            <a class="botao botao-perigo" asp-action="Excluir" asp-route-id="@Model.Id">Excluir</a>
        </div>
    }
</section>

<dl class="ficha">
    <div><dt>CNPJ</dt><dd>@Documento.FormatarCnpj(Model.Cnpj)</dd></div>
    <div><dt>E-mail</dt><dd>@Model.Email</dd></div>
    <div><dt>Login</dt><dd>Empresa parceira</dd></div>
</dl>

<p class="volta"><a asp-action="Index">Voltar para a lista</a></p>
