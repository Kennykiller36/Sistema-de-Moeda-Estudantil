@model VantagemFormulario
@{
    var editando = Model.Id is > 0;
    ViewData["Title"] = editando ? "Editar vantagem" : "Nova vantagem";
}

<section class="cabeca-pagina">
    <div>
        <p class="olho">Empresa parceira</p>
        <h1>@(editando ? "Editar vantagem" : "Nova vantagem")</h1>
        <p>@(editando ? "Envie outra foto só se quiser trocar a atual." : "A vantagem entra na vitrine dos alunos assim que for salva.")</p>
    </div>
</section>

<form class="formulario" method="post" enctype="multipart/form-data"
      asp-action="@(editando ? "EditarVantagem" : "NovaVantagem")"
      asp-route-vantagemId="@(editando ? Model.Id : null)">
    <input type="hidden" asp-for="FotoAtual" />
    <div asp-validation-summary="ModelOnly" class="aviso aviso-erro"></div>
    <div class="grade">
        <div class="campo campo-largo">
            <label asp-for="Descricao"></label>
            <textarea asp-for="Descricao" rows="3" maxlength="500" placeholder="Ex.: 20% de desconto no rodízio de segunda a quinta"></textarea>
            <span asp-validation-for="Descricao"></span>
        </div>
        <div class="campo">
            <label asp-for="CustoMoedas"></label>
            <input asp-for="CustoMoedas" type="number" min="1" step="1" inputmode="numeric" />
            <span asp-validation-for="CustoMoedas"></span>
        </div>
        <div class="campo">
            <label asp-for="Foto"></label>
            <input asp-for="Foto" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
            <span asp-validation-for="Foto"></span>
            <small class="detalhe">JPG, PNG, WEBP ou GIF de até 5 MB.</small>
        </div>
        @if (!string.IsNullOrEmpty(Model.FotoAtual))
        {
            <div class="campo campo-largo">
                <span>Foto atual</span>
                <img class="foto-atual" src="@ArmazenamentoFotosEmDisco.Url(Model.FotoAtual)" alt="Foto atual da vantagem" />
            </div>
        }
    </div>
    <div class="acoes">
        <button class="botao" type="submit">@(editando ? "Salvar alterações" : "Publicar vantagem")</button>
        <a class="botao botao-secundario" asp-action="Vantagens">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
