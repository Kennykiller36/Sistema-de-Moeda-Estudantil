@model IReadOnlyList<Vantagem>
@{
    ViewData["Title"] = "Minhas vantagens";
}

<section class="cabeca-pagina">
    <div>
        <p class="olho">Empresa parceira</p>
        <h1>Minhas vantagens</h1>
        <p>Cada vantagem tem descrição, foto do produto e custo em moedas. Só as ativas aparecem na vitrine dos alunos.</p>
    </div>
    <a class="botao" asp-action="NovaVantagem">Nova vantagem</a>
</section>

@if (Model.Count == 0)
{
    <p class="vazio">Nenhuma vantagem cadastrada ainda.</p>
}
else
{
    <div class="tabela-rolagem">
        <table>
            <thead>
                <tr>
                    <th>Foto</th>
                    <th>Descrição</th>
                    <th class="numero">Custo</th>
                    <th class="numero">Cupons</th>
                    <th>Situação</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var vantagem in Model)
            {
                var pendentes = vantagem.Cupons.Count(cupom => !cupom.Utilizado);
                <tr>
                    <td><img class="miniatura" src="@ArmazenamentoFotosEmDisco.Url(vantagem.Foto)" alt="Foto da vantagem" /></td>
                    <td>@vantagem.Descricao</td>
                    <td class="numero">@vantagem.CustoMoedas.ToString("N0")</td>
                    <td class="numero">@vantagem.Cupons.Count <span class="detalhe">@pendentes a conferir</span></td>
                    <td>
                        <span class="etiqueta @(vantagem.Ativa ? "etiqueta-ok" : null)">@(vantagem.Ativa ? "Na vitrine" : "Desativada")</span>
                    </td>
                    <td class="acoes-tabela">
                        <a asp-action="EditarVantagem" asp-route-vantagemId="@vantagem.Id">Editar</a>
                        <form class="em-linha" method="post" asp-action="AlterarSituacao" asp-route-vantagemId="@vantagem.Id">
                            <input type="hidden" name="ativa" value="@((!vantagem.Ativa).ToString().ToLowerInvariant())" />
                            <button class="link" type="submit">@(vantagem.Ativa ? "Desativar" : "Reativar")</button>
                        </form>
                        <a asp-action="ExcluirVantagem" asp-route-vantagemId="@vantagem.Id">Excluir</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
