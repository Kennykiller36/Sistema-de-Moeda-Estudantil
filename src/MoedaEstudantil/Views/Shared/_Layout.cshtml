<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Moeda Estudantil</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topo">
        <div class="topo-interno">
            <a class="marca" asp-controller="Home" asp-action="Index">
                <span class="selo" aria-hidden="true">M</span>
                <span>
                    <strong>Moeda Estudantil</strong>
                    <small>Reconhecimento de mérito</small>
                </span>
            </a>
            <nav class="menu">
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Aluno" asp-action="Novo">Cadastrar aluno</a>
                    <a asp-controller="Empresa" asp-action="Novo">Cadastrar empresa</a>
                    <a asp-controller="Autenticacao" asp-action="Entrar">Entrar</a>
                }
                else
                {
                    @if (User.IsInRole(nameof(TipoUsuario.Aluno)) && SessaoCookie.Id(User) is long alunoId)
                    {
                        <a asp-controller="Aluno" asp-action="Vantagens">Vantagens</a>
                        <a asp-controller="Aluno" asp-action="Extrato">Extrato</a>
                        <a asp-controller="Aluno" asp-action="Notificacoes">Notificações</a>
                        <a asp-controller="Empresa" asp-action="Index">Empresas</a>
                        <a asp-controller="Aluno" asp-action="Detalhes" asp-route-id="@alunoId">Meu cadastro</a>
                    }
                    @if (User.IsInRole(nameof(TipoUsuario.Professor)))
                    {
                        <a asp-controller="Professor" asp-action="Enviar">Enviar moedas</a>
                        <a asp-controller="Professor" asp-action="Extrato">Extrato</a>
                        <a asp-controller="Professor" asp-action="Alunos">Alunos</a>
                        <a asp-controller="Empresa" asp-action="Index">Empresas</a>
                        <a asp-controller="Professor" asp-action="Senha">Senha</a>
                    }
                    @if (User.IsInRole(nameof(TipoUsuario.Empresa)) && SessaoCookie.Id(User) is long empresaId)
                    {
                        <a asp-controller="Empresa" asp-action="Vantagens">Minhas vantagens</a>
                        <a asp-controller="Empresa" asp-action="Cupons">Cupons</a>
                        <a asp-controller="Empresa" asp-action="Notificacoes">Notificações</a>
                        <a asp-controller="Empresa" asp-action="Detalhes" asp-route-id="@empresaId">Meu cadastro</a>
                    }
                    <div class="conta">
                        <span class="usuario-atual">@User.Identity?.Name</span>
                        <form class="sair" asp-controller="Autenticacao" asp-action="Sair" method="post">
                            <button type="submit">Sair</button>
                        </form>
                    </div>
                }
            </nav>
        </div>
    </header>
    <main class="conteudo">
        @if (TempData["Mensagem"] is string mensagem)
        {
            <p class="aviso aviso-ok" role="status">@mensagem</p>
        }
        @if (TempData["MensagemAviso"] is string alerta)
        {
            <p class="aviso aviso-alerta" role="status">@alerta</p>
        }
        @if (TempData["MensagemErro"] is string erro)
        {
            <p class="aviso aviso-erro" role="alert">@erro</p>
        }
        @RenderBody()
    </main>
    <footer class="rodape">
        <p>Envio de moedas, vantagens, cupons e extratos, com aviso por e-mail.</p>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
