@{
    ViewData["Title"] = "Início";
    var autenticado = User.Identity?.IsAuthenticated == true;
}

<section class="abertura">
    <p class="olho">Laboratório 3 · Sprint 2</p>
    <h1>Moeda para reconhecer mérito estudantil</h1>
    <p class="resumo">
        Alunos e empresas parceiras entram por aqui. As instituições de ensino já estão no sistema,
        e o cadastro cria o login. Envio de moedas, vantagens e extrato ficam para a próxima sprint.
    </p>
</section>

@if (autenticado)
{
    <section class="painel">
        <h2>Olá, @User.Identity?.Name</h2>
        <p>Você está autenticado. Consulte os cadastros ou abra o seu.</p>
        <div class="acoes">
            @if (User.IsInRole("Aluno") && SessaoCookie.Id(User) is long alunoId)
            {
                <a class="botao" asp-controller="Aluno" asp-action="Detalhes" asp-route-id="@alunoId">Meu cadastro</a>
            }
            @if (User.IsInRole("Empresa") && SessaoCookie.Id(User) is long empresaId)
            {
                <a class="botao" asp-controller="Empresa" asp-action="Detalhes" asp-route-id="@empresaId">Meu cadastro</a>
            }
            <a class="botao botao-secundario" asp-controller="Aluno" asp-action="Index">Lista de alunos</a>
            <a class="botao botao-secundario" asp-controller="Empresa" asp-action="Index">Lista de empresas</a>
        </div>
    </section>
}

<div class="cartoes">
    <article class="cartao">
        <h2>Aluno</h2>
        <p>Nome, e-mail, CPF, RG, endereço, instituição e curso. A instituição é escolhida entre as que já participam.</p>
        <a class="botao" asp-controller="Aluno" asp-action="Novo">Cadastrar aluno</a>
    </article>
    <article class="cartao">
        <h2>Empresa parceira</h2>
        <p>Nome fantasia, CNPJ, e-mail e senha. O acesso às funções da empresa passa por esse login.</p>
        <a class="botao" asp-controller="Empresa" asp-action="Novo">Cadastrar empresa</a>
    </article>
</div>
