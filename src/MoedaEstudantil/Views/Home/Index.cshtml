@{
    ViewData["Title"] = "Início";
}

<section class="abertura">
    <p class="olho">Laboratório 3 · Sprint 3</p>
    <h1>Moeda para reconhecer mérito estudantil</h1>
    <p class="resumo">
        Professores distribuem moedas aos alunos pelo bom desempenho. Os alunos trocam as moedas
        por vantagens das empresas parceiras e recebem um cupom por e-mail para a troca presencial.
    </p>
</section>

@if (User.IsInRole(nameof(TipoUsuario.Aluno)))
{
    <section class="painel">
        <h2>Olá, @User.Identity?.Name</h2>
        <p>Veja o saldo e os recebimentos no extrato, ou escolha uma vantagem para trocar.</p>
        <div class="acoes">
            <a class="botao" asp-controller="Aluno" asp-action="Vantagens">Trocar moedas</a>
            <a class="botao botao-secundario" asp-controller="Aluno" asp-action="Extrato">Extrato</a>
            <a class="botao botao-secundario" asp-controller="Aluno" asp-action="Notificacoes">Notificações</a>
        </div>
    </section>
}
else if (User.IsInRole(nameof(TipoUsuario.Professor)))
{
    <section class="painel">
        <h2>Olá, @User.Identity?.Name</h2>
        <p>Você recebe 1.000 moedas por semestre, somadas ao saldo que sobrou. Reconheça um aluno da sua instituição.</p>
        <div class="acoes">
            <a class="botao" asp-controller="Professor" asp-action="Enviar">Enviar moedas</a>
            <a class="botao botao-secundario" asp-controller="Professor" asp-action="Extrato">Extrato</a>
            <a class="botao botao-secundario" asp-controller="Professor" asp-action="Alunos">Alunos</a>
        </div>
    </section>
}
else if (User.IsInRole(nameof(TipoUsuario.Empresa)))
{
    <section class="painel">
        <h2>Olá, @User.Identity?.Name</h2>
        <p>Cadastre vantagens com foto e custo em moedas. Quando um aluno troca, o cupom chega no seu e-mail para conferência.</p>
        <div class="acoes">
            <a class="botao" asp-controller="Empresa" asp-action="NovaVantagem">Nova vantagem</a>
            <a class="botao botao-secundario" asp-controller="Empresa" asp-action="Vantagens">Minhas vantagens</a>
            <a class="botao botao-secundario" asp-controller="Empresa" asp-action="Cupons">Conferir cupom</a>
        </div>
    </section>
}
else
{
    <div class="cartoes">
        <article class="cartao">
            <h2>Aluno</h2>
            <p>Cadastre-se com a sua instituição de ensino, receba moedas dos professores e troque por vantagens.</p>
            <a class="botao" asp-controller="Aluno" asp-action="Novo">Cadastrar aluno</a>
        </article>
        <article class="cartao">
            <h2>Professor</h2>
            <p>O cadastro vem da instituição parceira. Entre com o e-mail institucional e a senha recebida.</p>
            <a class="botao" asp-controller="Autenticacao" asp-action="Entrar">Entrar</a>
        </article>
        <article class="cartao">
            <h2>Empresa parceira</h2>
            <p>Cadastre a empresa e as vantagens oferecidas, com descrição, foto e custo em moedas.</p>
            <a class="botao" asp-controller="Empresa" asp-action="Novo">Cadastrar empresa</a>
        </article>
    </div>
}
