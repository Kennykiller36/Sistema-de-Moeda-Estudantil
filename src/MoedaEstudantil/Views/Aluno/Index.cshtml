@model IReadOnlyList<Aluno>
@{
    ViewData["Title"] = "Alunos";
}

<section class="cabeca-pagina">
    <div>
        <h1>Alunos</h1>
        <p>Cadastros gravados no banco. Editar e excluir vale só para o próprio login.</p>
    </div>
    <a class="botao" asp-action="Novo">Novo aluno</a>
</section>

@if (Model.Count == 0)
{
    <p class="vazio">Nenhum aluno cadastrado ainda.</p>
}
else
{
    <div class="tabela-rolagem">
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>CPF</th>
                    <th>Instituição</th>
                    <th>Curso</th>
                    <th>Saldo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var aluno in Model)
            {
                <tr>
                    <td>@aluno.Nome</td>
                    <td>@aluno.Email</td>
                    <td>@Documento.FormatarCpf(aluno.Cpf)</td>
                    <td>@aluno.Instituicao.Nome</td>
                    <td>@aluno.Curso</td>
                    <td>@aluno.Saldo</td>
                    <td class="acoes-tabela">
                        <a asp-action="Detalhes" asp-route-id="@aluno.Id">Abrir</a>
                        @if (SessaoCookie.EhDono(User, aluno.Id))
                        {
                            <a asp-action="Editar" asp-route-id="@aluno.Id">Editar</a>
                            <a asp-action="Excluir" asp-route-id="@aluno.Id">Excluir</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
