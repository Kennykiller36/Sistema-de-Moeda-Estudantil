@model Aluno
@{
    ViewData["Title"] = "Excluir aluno";
}

<section class="cabeca-pagina">
    <div>
        <h1>Excluir cadastro</h1>
        <p>@Model.Nome (@Model.Email) será removido do sistema. Esta ação não pode ser desfeita.</p>
    </div>
</section>

<form class="formulario formulario-estreito" method="post" asp-action="ConfirmarExclusao" asp-route-id="@Model.Id">
    <div class="acoes">
        <button class="botao botao-perigo" type="submit">Excluir aluno</button>
        <a class="botao botao-secundario" asp-action="Detalhes" asp-route-id="@Model.Id">Cancelar</a>
    </div>
</form>
