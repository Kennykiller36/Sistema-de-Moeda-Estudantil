@model Aluno
@{
    ViewData["Title"] = Model.Nome;
}

<section class="cabeca-pagina">
    <div>
        <p class="olho">Aluno</p>
        <h1>@Model.Nome</h1>
        <p>@Model.Email</p>
    </div>
    @if (SessaoCookie.EhDono(User, Model.Id))
    {
        <div class="acoes">
            <a class="botao" asp-action="Editar" asp-route-id="@Model.Id">Editar</a>
            <a class="botao botao-perigo" asp-action="Excluir" asp-route-id="@Model.Id">Excluir</a>
        </div>
    }
</section>

<dl class="ficha">
    <div><dt>CPF</dt><dd>@Documento.FormatarCpf(Model.Cpf)</dd></div>
    <div><dt>RG</dt><dd>@Model.Rg</dd></div>
    <div><dt>Endereço</dt><dd>@Model.Endereco</dd></div>
    <div><dt>Instituição</dt><dd>@Model.Instituicao.Nome — @Model.Instituicao.Cidade</dd></div>
    <div><dt>Curso</dt><dd>@Model.Curso</dd></div>
    <div><dt>Saldo</dt><dd>@Model.Saldo moedas</dd></div>
</dl>

<p class="volta"><a asp-action="Index">Voltar para a lista</a></p>
