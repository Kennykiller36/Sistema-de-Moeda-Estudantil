@model AlunoFormulario
@{
    var editando = Model.Id is > 0;
    ViewData["Title"] = editando ? "Editar aluno" : "Cadastrar aluno";
}

<section class="cabeca-pagina">
    <div>
        <h1>@(editando ? "Editar aluno" : "Cadastrar aluno")</h1>
        <p>@(editando ? "A senha atual permanece se os campos de senha ficarem em branco." : "O e-mail e a senha criados aqui são o login. A instituição já está pré-cadastrada.")</p>
    </div>
</section>

<form class="formulario" method="post" asp-action="@(editando ? "Editar" : "Novo")" asp-route-id="@(editando ? Model.Id : null)">
    @if (editando)
    {
        <input type="hidden" asp-for="Id" />
    }
    <div asp-validation-summary="ModelOnly" class="aviso aviso-erro"></div>
    <div class="grade">
        <div class="campo">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" autocomplete="name" />
            <span asp-validation-for="Nome"></span>
        </div>
        <div class="campo">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="username" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="campo">
            <label asp-for="Senha"></label>
            <input asp-for="Senha" autocomplete="new-password" />
            <span asp-validation-for="Senha"></span>
        </div>
        <div class="campo">
            <label asp-for="ConfirmarSenha"></label>
            <input asp-for="ConfirmarSenha" autocomplete="new-password" />
            <span asp-validation-for="ConfirmarSenha"></span>
        </div>
        <div class="campo">
            <label asp-for="Cpf"></label>
            <input asp-for="Cpf" inputmode="numeric" data-mascara="###.###.###-##" autocomplete="off" />
            <span asp-validation-for="Cpf"></span>
        </div>
        <div class="campo">
            <label asp-for="Rg"></label>
            <input asp-for="Rg" autocomplete="off" />
            <span asp-validation-for="Rg"></span>
        </div>
        <div class="campo campo-largo">
            <label asp-for="Endereco"></label>
            <input asp-for="Endereco" autocomplete="street-address" />
            <span asp-validation-for="Endereco"></span>
        </div>
        <div class="campo">
            <label asp-for="InstituicaoId"></label>
            <select asp-for="InstituicaoId" asp-items="Model.Instituicoes">
                <option value="0">Selecione</option>
            </select>
            <span asp-validation-for="InstituicaoId"></span>
        </div>
        <div class="campo">
            <label asp-for="Curso"></label>
            <input asp-for="Curso" />
            <span asp-validation-for="Curso"></span>
        </div>
    </div>
    <div class="acoes">
        <button class="botao" type="submit">@(editando ? "Salvar alterações" : "Cadastrar")</button>
        @if (editando)
        {
            <a class="botao botao-secundario" asp-action="Detalhes" asp-route-id="@Model.Id">Cancelar</a>
        }
        else
        {
            <a class="botao botao-secundario" asp-controller="Home" asp-action="Index">Cancelar</a>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
