<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="CursorLab3" version="22.1.0" type="device">
  <diagram id="HistoriasDoUsuario" name="HistoriasDoUsuario">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title_us" value="Histórias do Usuário — Sistema de Moeda Estudantil (Lab03S01)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="col_a" value="Como Aluno" style="swimlane;startSize=36;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="370" height="660" as="geometry"/>
        </mxCell>
        <mxCell id="col_p" value="Como Professor" style="swimlane;startSize=36;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="70" width="370" height="660" as="geometry"/>
        </mxCell>
        <mxCell id="col_e" value="Como Empresa Parceira" style="swimlane;startSize=36;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="70" width="370" height="660" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="HU-01 Cadastro&#xa;Como aluno, quero me cadastrar com nome, e-mail, CPF, RG, endereço, instituição e curso, para participar do sistema de mérito." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;fontSize=11;shadow=1;" vertex="1" parent="col_a">
          <mxGeometry x="20" y="50" width="330" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="HU-02 Login&#xa;Como aluno, quero autenticar com login e senha, para acessar minha conta com segurança." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;fontSize=11;shadow=1;" vertex="1" parent="col_a">
          <mxGeometry x="20" y="175" width="330" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="HU-03 Extrato&#xa;Como aluno, quero consultar meu saldo e as transações (recebimentos e trocas), para acompanhar minhas moedas." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;fontSize=11;shadow=1;" vertex="1" parent="col_a">
          <mxGeometry x="20" y="270" width="330" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="HU-04 Resgate&#xa;Como aluno, quero trocar moedas por uma vantagem e receber cupom por e-mail, para usufruir do benefício." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;fontSize=11;shadow=1;" vertex="1" parent="col_a">
          <mxGeometry x="20" y="385" width="330" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="HU-05 Notificação&#xa;Como aluno, quero ser notificado por e-mail ao receber moedas, para saber quando fui reconhecido." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;fontSize=11;shadow=1;" vertex="1" parent="col_a">
          <mxGeometry x="20" y="500" width="330" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="HU-06 Login professor&#xa;Como professor, quero autenticar com login e senha, para acessar o sistema." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;fontSize=11;shadow=1;" vertex="1" parent="col_p">
          <mxGeometry x="20" y="50" width="330" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s7" value="HU-07 Enviar moedas&#xa;Como professor, quero enviar moedas a um aluno (saldo suficiente + motivo obrigatório), para reconhecer mérito." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;fontSize=11;shadow=1;" vertex="1" parent="col_p">
          <mxGeometry x="20" y="145" width="330" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s8" value="HU-08 Extrato professor&#xa;Como professor, quero consultar meu saldo e os envios realizados, para controlar a distribuição." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;fontSize=11;shadow=1;" vertex="1" parent="col_p">
          <mxGeometry x="20" y="275" width="330" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s9" value="HU-09 Crédito semestral&#xa;Como professor, quero receber 1.000 moedas acumuláveis a cada semestre, para continuar reconhecendo alunos." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;fontSize=11;shadow=1;" vertex="1" parent="col_p">
          <mxGeometry x="20" y="395" width="330" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s10" value="HU-10 Cadastro empresa&#xa;Como empresa parceira, quero me cadastrar com login/senha, para oferecer vantagens." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;fontSize=11;shadow=1;" vertex="1" parent="col_e">
          <mxGeometry x="20" y="50" width="330" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s11" value="HU-11 Cadastrar vantagem&#xa;Como empresa, quero cadastrar vantagens com descrição, foto e custo em moedas, para atrair alunos." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;fontSize=11;shadow=1;" vertex="1" parent="col_e">
          <mxGeometry x="20" y="160" width="330" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s12" value="HU-12 Conferência&#xa;Como empresa, quero receber e-mail com código ao resgate, para conferir a troca presencial." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;fontSize=11;shadow=1;" vertex="1" parent="col_e">
          <mxGeometry x="20" y="290" width="330" height="110" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
